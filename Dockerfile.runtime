# Offline/local Go toolchain build: scripts/build-local-image.sh prepares this context.
FROM scratch
WORKDIR /app
COPY alterhive /app/alterhive
COPY ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY configs/topology.yaml /app/configs/topology.yaml
COPY configs/services/ssh.yaml /app/configs/services/ssh.yaml
COPY --chown=10001:20000 sockets/ /run/alterhive/decisions/
COPY --chown=10002:20000 sockets/ /run/alterhive/ingress/
USER 10002:20000
ENTRYPOINT ["/app/alterhive"]
